# App Variant Configuration
# Used to differentiate between development, preview, and production builds
# Valid values: "development", "preview", "production"
#
# This environment variable is automatically set in EAS builds via eas.json
# based on the build profile you're using.
#
# For local development, this is set via the "dev" script in package.json:
#   pnpm run dev
#
# If you need to run the app with a different variant locally, you can set it manually:
#   APP_VARIANT=preview pnpm expo start
APP_VARIANT=development
